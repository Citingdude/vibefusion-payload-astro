---
import Layout from '@/layouts/Layout.astro'
import { getLocalPayload } from '@/lib/payload'

const payload = await getLocalPayload()
const { totalDocs: mediaCount, docs } = await payload.find({
  collection: 'media',
  depth: 0,
  limit: 0,
})
---

<Layout>
  <section>
    <div class="container">
      <h1>Astro</h1>
      <p>{mediaCount} media {mediaCount === 1 ? 'item' : 'items'} in Payload.</p>

      <img src="" alt="">

      {docs.map(item => (
        <p>{item.alt}</p>
        <img class="size-8" src={item.url} />
))}
    </div>
  </section>
</Layout>
