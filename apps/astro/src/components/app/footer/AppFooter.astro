---
import AppLogo from '@/components/app/logo/AppLogo.astro'

const year = new Date().getFullYear()
---

<footer class="bg-neutral-950 text-neutral-0">
  <div class="container py-12 sm:py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <AppLogo variant="light" />

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-6 gap-y-3 text-lg text-neutral-300">
          <li>
            <a
              class="transition-colors hover:text-neutral-0 focus-visible:text-neutral-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300"
              href="/websites"
              >Websites</a
            >
          </li>
          <li>
            <a
              class="transition-colors hover:text-neutral-0 focus-visible:text-neutral-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300"
              href="/cases"
              >Cases</a
            >
          </li>
          <li>
            <a
              class="transition-colors hover:text-neutral-0 focus-visible:text-neutral-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300"
              href="/werkwijze"
              >Werkwijze</a
            >
          </li>
          <li>
            <a
              class="transition-colors hover:text-neutral-0 focus-visible:text-neutral-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300"
              href="/over-ons"
              >Over ons</a
            >
          </li>
          <li>
            <a
              class="transition-colors hover:text-neutral-0 focus-visible:text-neutral-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-300"
              href="/contact"
              >Contact</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-neutral-800 pt-6 text-sm text-neutral-400">
      <p>© {year} Vibefusion. All rights reserved.</p>
    </div>
  </div>
</footer>
