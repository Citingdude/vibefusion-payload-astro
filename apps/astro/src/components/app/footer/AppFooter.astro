---
import AppLogo from '@/components/app/logo/AppLogo.astro'
const year = new Date().getFullYear()
const links = [['Websites', '/websites'], ['Cases', '/cases'], ['Werkwijze', '/werkwijze'], ['Over ons', '/over-ons'], ['Contact', '/contact']]
---

<footer class="border-t border-border-default bg-muted">
  <div class="container py-12 sm:py-16">
    <div class="flex flex-col justify-between gap-10 md:flex-row md:items-start">
      <div>
        <AppLogo />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">Een kleine digitale studio.<br />Heldere ideeën. Sterk digitaal werk.</p>
      </div>
      <nav aria-label="Footernavigatie">
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-toned">
          {links.map(([label, href]) => <li><a class="inline-flex min-h-11 items-center transition-colors hover:text-primary" href={href}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="mt-12 flex flex-col justify-between gap-3 border-t border-border-default pt-6 text-xs text-muted sm:flex-row">
      <p>© {year} Vibefusion</p>
      <p>Digitale ervaringen met karakter.</p>
    </div>
  </div>
</footer>
