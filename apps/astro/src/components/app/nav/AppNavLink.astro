---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const props = Astro.props
---

<li>
  <a
    class="font-body rounded-xs text-lg font-medium text-foreground transition-colors hover:text-primary focus-visible:text-primary focus-ring"
    href={props.href}
  >
    <slot />
  </a>
</li>
