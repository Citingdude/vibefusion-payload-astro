---
import type { HTMLAttributes } from 'astro/types'
type Props = HTMLAttributes<'a'>
const { href, class: className, ...attributes } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const active = currentPath === String(href).replace(/\/$/, '') || (href === '/' && currentPath === '/')
---

<li>
  <a href={href} aria-current={active ? 'page' : undefined} class:list={['nav-link', href === '/contact' && 'nav-contact', className]} {...attributes}>
    <slot />
    {href === '/contact' && <span aria-hidden="true">↗</span>}
  </a>
</li>

<style>
  .nav-link { display: flex; align-items: center; justify-content: space-between; gap: 1.75rem; min-height: 2.75rem; padding-block: 0.5rem; font-size: 0.8125rem; font-weight: 500; color: var(--ui-text-muted); transition: color 150ms, background-color 150ms; }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--ui-primary); }
  .nav-contact { background: var(--ui-bg-inverted); color: var(--ui-text-inverted); padding-inline: 1.125rem; border-radius: var(--radius-md); }
  .nav-contact:hover, .nav-contact[aria-current='page'] { background: var(--ui-primary); color: var(--ui-primary-foreground); }
</style>
