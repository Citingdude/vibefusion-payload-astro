---
interface Props {
  variant?: 'brand' | 'dark'
  label?: string
  caption?: string
}
const { variant = 'brand', label = 'Strategie. Design. Techniek.', caption = 'Sterk in elk detail.' } = Astro.props
---

<div class:list={['brand-panel', variant === 'dark' && 'brand-panel-dark']} aria-hidden="true">
  <div class="panel-top"><span>V / F</span><span>Digitale studio</span></div>
  <div class="panel-art">
    <svg viewBox="0 0 155.15 54" class="panel-mark">
      <path fill="currentColor" d="M112.84,5.84a20,20,0,0,0-28.21,0L56.42,34.05,28.21,5.84A20,20,0,0,0,0,5.84L42.32,48.16a19.94,19.94,0,0,0,28.2,0L98.73,20l28.21,28.21a20,20,0,0,0,28.21,0Z" />
      <path fill="currentColor" d="M81.1,48.16a20,20,0,0,0,28.21,0L95.21,34.05Z" />
    </svg>
  </div>
  <div class="panel-bottom"><p>{caption}</p><span>{label}</span></div>
</div>

<style>
  .brand-panel { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 1 / 1.05; overflow: hidden; border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.5rem); background: var(--ui-brand-600); color: var(--ui-primary-foreground); }
  .brand-panel-dark { background: var(--ui-neutral-950); }
  .panel-top { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.14em; }
  .panel-top span:first-child { font-weight: 600; }
  .panel-art { position: relative; display: flex; align-items: center; justify-content: center; flex: 1; margin-block: 2.5rem; }
  .panel-art::before, .panel-art::after { content: ''; position: absolute; inset-inline: -4rem; height: 1px; background: currentColor; opacity: 0.2; }
  .panel-art::before { top: 15%; }
  .panel-art::after { bottom: 15%; }
  .panel-mark { width: 100%; height: auto; }
  .brand-panel-dark .panel-mark { color: var(--ui-brand-300); }
  .panel-bottom { display: flex; flex-direction: column; gap: 0.75rem; }
  .panel-bottom p { max-width: 10ch; font-size: clamp(2rem, 3.2vw, 3rem); line-height: 1.05; letter-spacing: -0.05em; font-weight: 500; }
  .panel-bottom span { font-size: 0.6875rem; letter-spacing: 0.025em; }
</style>
