---
interface Props {
  variant?: 'default' | 'light'
}
const { variant = 'default' } = Astro.props
---

<a href="/" aria-label="Vibefusion — home" class:list={['logo', variant === 'light' && 'logo-light']}>
  <svg aria-hidden="true" viewBox="0 0 155.15 54" class="logo-mark">
    <path fill="currentColor" d="M112.84,5.84a20,20,0,0,0-28.21,0L56.42,34.05,28.21,5.84A20,20,0,0,0,0,5.84L42.32,48.16a19.94,19.94,0,0,0,28.2,0L98.73,20l28.21,28.21a20,20,0,0,0,28.21,0Z" />
    <path fill="currentColor" d="M81.1,48.16a20,20,0,0,0,28.21,0L95.21,34.05Z" />
  </svg>
  <span>vibefusion<span class="logo-period">.</span></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.65rem; flex-shrink: 0; color: var(--ui-text-highlighted); font-size: 1.375rem; font-weight: 600; letter-spacing: -0.065em; line-height: 1; padding-block: 0.75rem; }
  .logo-mark { width: 2.4rem; height: auto; color: var(--ui-brand-600); }
  .logo-period { color: var(--ui-brand-600); }
  .logo-light { color: var(--ui-neutral-0); }
</style>
