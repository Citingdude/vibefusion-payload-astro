---
import type { HTMLAttributes } from 'astro/types'

type AnchorAttributes = Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'>
type ButtonAttributes = Omit<HTMLAttributes<'button'>, 'type'>

type ButtonVariant = 'primary' | 'secondary' | 'tertiary' | 'outline' | 'ghost'
type ButtonSize = 'sm' | 'md' | 'lg'

interface Props extends AnchorAttributes, ButtonAttributes {
  /**
   * Semantic button treatment. Colours are defined by the shared Tailwind
   * design tokens, rather than by individual colour names.
   */
  variant?: ButtonVariant
  size?: ButtonSize
  href?: string | URL
  target?: '_blank' | '_parent' | '_self' | '_top'
  rel?: string
  type?: 'button' | 'submit' | 'reset'
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  class: className,
  ...attributes
} = Astro.props

const hasIconLeft = Astro.slots.has('icon-left')
const hasIconRight = Astro.slots.has('icon-right')

const buttonClasses = [
  'inline-flex w-full items-center justify-center rounded-br-md rounded-tl-md font-display font-bold duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:pointer-events-none disabled:opacity-50 sm:w-fit transition-all ease-out active:scale-98',
  (hasIconLeft || hasIconRight) && 'gap-2',
  {
    sm: 'px-4 py-2 text-sm',
    md: 'px-5 py-3 text-base',
    lg: 'px-6 py-4 text-lg',
  }[size],
  {
    primary: 'bg-primary text-primary-foreground hover:bg-primary-hover active:bg-primary-active',
    secondary: 'border border-border-default border-primary bg-primary/10 text-default hover:bg-primary/5',
    tertiary: 'bg-neutral-950 text-neutral-0 hover:bg-neutral-900 active:bg-neutral-800',
    outline: 'border border-primary text-primary hover:bg-primary-subtle active:bg-primary-muted',
    ghost: 'text-primary hover:bg-primary-subtle active:bg-primary-muted',
  }[variant],
]
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel}
      class:list={[buttonClasses, className]}
      {...attributes}
    >
      {hasIconLeft && <slot name="icon-left" />}
      <slot />
      {hasIconRight && <slot name="icon-right" />}
    </a>
  ) : (
    <button
      type={type}
      class:list={[buttonClasses, className]}
      {...attributes}
    >
      {hasIconLeft && <slot name="icon-left" />}
      <slot />
      {hasIconRight && <slot name="icon-right" />}
    </button>
  )
}
