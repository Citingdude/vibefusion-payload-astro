---
import type { HTMLAttributes } from 'astro/types'

type AnchorAttributes = Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'>
type ButtonAttributes = Omit<HTMLAttributes<'button'>, 'type'>

type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'ghost'
type ButtonSize = 'sm' | 'md' | 'lg'

interface Props extends AnchorAttributes, ButtonAttributes {
  /**
   * Semantic button treatment. Colours are defined by the shared Tailwind
   * design tokens, rather than by individual colour names.
   */
  variant?: ButtonVariant
  size?: ButtonSize
  href?: string | URL
  target?: '_blank' | '_parent' | '_self' | '_top'
  rel?: string
  type?: 'button' | 'submit' | 'reset'
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  class: className,
  ...attributes
} = Astro.props

const buttonClasses = [
  'inline-flex w-full items-center justify-center rounded-br-md rounded-tl-md font-display font-bold duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:pointer-events-none disabled:opacity-50 sm:w-fit transition-all ease-out',
  {
    sm: 'px-4 py-2 text-sm',
    md: 'px-5 py-3 text-base',
    lg: 'px-6 py-4 text-lg',
  }[size],
  {
    primary: 'bg-brand text-white hover:bg-brand-hover active:bg-brand-active',
    secondary: 'border border-brand bg-surface text-foreground hover:border-brand hover:bg-brand-subtle',
    outline: 'border border-brand text-brand hover:bg-brand-subtle active:bg-brand-subtle',
    ghost: 'text-brand hover:bg-brand-subtle active:bg-brand-subtle',
  }[variant],
]
---

{
  href
    ? (
        <a href={href} target={target} rel={rel} class:list={[buttonClasses, className]} {...attributes}>
          <slot />
        </a>
      )
    : (
      <button type={type} class:list={[buttonClasses, className]} {...attributes}>
        <slot />
      </button>
    )
}
