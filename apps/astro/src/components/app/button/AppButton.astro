---
import type { HTMLAttributes } from 'astro/types'

type AnchorAttributes = Omit<HTMLAttributes<'a'>, 'href' | 'target' | 'rel'>
type ButtonAttributes = Omit<HTMLAttributes<'button'>, 'type'>

type ButtonVariant = 'primary' | 'secondary' | 'tertiary' | 'outline' | 'ghost' | 'inverse'
type ButtonSize = 'sm' | 'md' | 'lg'

interface Props extends AnchorAttributes, ButtonAttributes {
  /**
   * Semantic button treatment. Colours are defined by the shared Tailwind
   * design tokens, rather than by individual colour names.
   */
  variant?: ButtonVariant
  size?: ButtonSize
  href?: string | URL
  target?: '_blank' | '_parent' | '_self' | '_top'
  rel?: string
  type?: 'button' | 'submit' | 'reset'
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  class: className,
  ...attributes
} = Astro.props

const hasIconLeft = Astro.slots.has('icon-left')
const hasIconRight = Astro.slots.has('icon-right')

const buttonClasses = [
  'app-button inline-flex min-h-11 w-full items-center justify-center rounded-md font-body font-medium duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus disabled:pointer-events-none disabled:opacity-50 sm:w-fit transition-colors ease-out',
  (hasIconLeft || hasIconRight) && 'gap-4',
  {
    sm: 'px-4 py-2 text-sm',
    md: 'px-5 py-3 text-sm',
    lg: 'px-6 py-4 text-sm',
  }[size],
  {
    primary: 'bg-primary text-primary-foreground hover:bg-primary-hover active:bg-primary-active',
    secondary: 'border border-border-default bg-elevated text-default hover:bg-muted',
    tertiary: 'bg-neutral-950 text-neutral-0 hover:bg-neutral-900 active:bg-neutral-800',
    outline: 'border border-primary text-primary hover:bg-primary-subtle active:bg-primary-muted',
    inverse: 'bg-neutral-0 text-neutral-950 hover:bg-neutral-100 active:bg-neutral-200',
    ghost: 'text-primary hover:bg-primary-subtle active:bg-primary-muted',
  }[variant],
]
---

{
  href ? (
    <a
      href={href}
      target={target}
      rel={rel}
      class:list={[buttonClasses, className]}
      {...attributes}
    >
      {hasIconLeft && <slot name="icon-left" />}
      <slot />
      {hasIconRight && <slot name="icon-right" />}
    </a>
  ) : (
    <button
      type={type}
      class:list={[buttonClasses, className]}
      {...attributes}
    >
      {hasIconLeft && <slot name="icon-left" />}
      <slot />
      {hasIconRight && <slot name="icon-right" />}
    </button>
  )
}

<style>
  .app-button :global(svg) { flex-shrink: 0; transition: transform 150ms ease; }
  @media (hover: hover) { .app-button:hover :global(svg) { transform: translateX(3px); } }
</style>
