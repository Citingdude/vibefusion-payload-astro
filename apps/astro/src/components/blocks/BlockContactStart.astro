---
import AppEyebrow from '@/components/app/eyebrow/AppEyebrow.astro'

const prompts = [
  'Wat doet je organisatie en voor wie?',
  'Waar loopt je huidige website op vast?',
  'Wat moet de nieuwe website mogelijk maken?',
  'Is er een belangrijk moment waar je naartoe werkt?',
]
---

<section
  id="project"
  class="scroll-mt-8 bg-background section-space"
>
  <div class="container grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20">
    <div class="max-w-md">
      <AppEyebrow label="Een goed begin" />
      <h2 class="mt-4 section-title text-highlighted">
        Je hoeft nog niet alles te weten.
      </h2>
      <p class="mt-5 section-intro text-toned">
        Een eerste idee, een bestaande uitdaging of een duidelijke ambitie is genoeg. Wij helpen je om van daaruit de
        juiste vraag scherp te krijgen.
      </p>
    </div>

    <div class="rounded-lg border border-border-default bg-elevated p-6 sm:p-8 lg:p-10">
      <p class="text-sm font-bold tracking-widest text-primary uppercase">Handig om alvast te delen</p>
      <ul class="mt-7 divide-y divide-border-default border-y border-border-default">
        {
          prompts.map((prompt, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-3 py-5">
              <span class="index-label text-primary">0{index + 1}</span>
              <span class="text-lg text-toned">{prompt}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-7 rounded-md bg-muted p-5 text-base leading-relaxed text-toned">
        De directe contactmogelijkheid wordt hier aangesloten zodra het gewenste kanaal is bevestigd. Zo publiceren we
        geen onbevestigd adres en raakt je bericht niet verloren.
      </p>
    </div>
  </div>
</section>
