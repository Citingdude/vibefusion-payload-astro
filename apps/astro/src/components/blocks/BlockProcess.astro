---
import AppButton from '@/components/app/button/AppButton.astro'
import AppEyebrow from '@/components/app/eyebrow/AppEyebrow.astro'
import IconArrowRight from '@/components/icons/IconArrowRight.astro'

const phases = [
  {
    label: 'Kennismaken & richting bepalen',
    title: 'We beginnen bij jouw verhaal.',
    description:
      'We luisteren, stellen vragen en brengen je ambities in kaart. Samen bepalen we wat je website moet vertellen en mogelijk maken.',
  },
  {
    label: 'Ontwerpen & bouwen',
    title: 'We geven je idee karakter.',
    description:
      'Strategie wordt een herkenbaar ontwerp en een werkende website. Jij kijkt mee en geeft feedback op heldere momenten.',
  },
  {
    label: 'Controleren & lanceren',
    title: 'We zetten de volgende stap samen.',
    description:
      'We lopen alles zorgvuldig na, zetten je website live en zorgen voor een duidelijke overdracht. Klaar om zelf verder te gaan.',
  },
]
---

<section
  aria-labelledby="werkwijze-title"
  class="section-space border-t border-border-default bg-muted"
>
  <div class="container">
    <div class="process-content">
      <div class="grid items-end gap-8 lg:grid-cols-[1fr_auto] lg:gap-16">
        <div class="max-w-2xl">
          <AppEyebrow label="Onze werkwijze" />
          <h2
            id="werkwijze-title"
            class="mt-4 section-title text-highlighted"
          >
            Van eerste gesprek tot iets dat klopt.
          </h2>
          <p class="mt-5 section-intro text-toned">
            Een goed resultaat begint met een helder proces. Met korte lijnen en ruimte voor jouw input weet je steeds
            waar we staan en wat de volgende stap is.
          </p>
        </div>
        <AppButton
          href="/werkwijze"
          variant="outline"
        >
          Ontdek onze werkwijze
          <IconArrowRight slot="icon-right" />
        </AppButton>
      </div>

      <ol class="mt-12 grid gap-8 lg:grid-cols-3 lg:gap-10">
        {
          phases.map((phase, index) => (
            <li class="border-t border-border-default pt-6">
              <span
                class="index-label text-primary"
                aria-hidden="true"
              >
                0{index + 1}
              </span>
              <p class="mt-6 text-xs font-medium tracking-wide text-muted uppercase">{phase.label}</p>
              <h3 class="mt-3 card-title text-highlighted">{phase.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-toned">{phase.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
