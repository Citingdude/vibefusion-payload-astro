---
import AppButton from '@/components/app/button/AppButton.astro'
import AppEyebrow from '@/components/app/eyebrow/AppEyebrow.astro'
import IconArrowRight from '@/components/icons/IconArrowRight.astro'

interface Props {
  eyebrow?: string
  title?: string
  description?: string
  action?: { label: string; href: string }
}

const {
  eyebrow = 'Klaar om te beginnen?',
  title = 'Laten we iets maken dat blijft hangen.',
  description = 'Vertel ons waar je naartoe wilt. Wij denken mee over de slimste route van eerste idee tot sterke digitale ervaring.',
  action = { label: 'Start een project', href: '/contact' },
} = Astro.props
---

<section class="section-space bg-inverted text-inverted">
  <div class="container">
    <AppEyebrow label={eyebrow} class="text-neutral-300" />
    <div class="mt-7 grid items-end gap-10 lg:grid-cols-[1fr_auto] lg:gap-20">
      <div class="max-w-3xl">
        <h2 class="section-title">{title}</h2>
        <p class="section-intro mt-6 max-w-xl text-neutral-300">{description}</p>
      </div>
      <AppButton href={action.href} size="lg" variant="inverse">
        {action.label}<IconArrowRight slot="icon-right" />
      </AppButton>
    </div>
  </div>
</section>
