---
import AppBrandPanel from '@/components/app/brand/AppBrandPanel.astro'
import AppButton from '@/components/app/button/AppButton.astro'
import AppEyebrow from '@/components/app/eyebrow/AppEyebrow.astro'
import IconArrowRight from '@/components/icons/IconArrowRight.astro'

interface Props {
  eyebrow?: string
  title?: string
  description?: string
  primaryAction?: { label: string; href: string }
  secondaryAction?: { label: string; href: string }
}

const {
  eyebrow = 'Digitale ervaringen met karakter',
  title = 'Websites die voelen als jouw merk.',
  description = 'Van eerste idee tot een digitale ervaring die mensen bijblijft. We combineren heldere strategie, sterk design en slimme techniek.',
  primaryAction = { label: 'Start een project', href: '/contact' },
  secondaryAction = { label: 'Bekijk ons werk', href: '/cases' },
} = Astro.props
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <AppEyebrow label={eyebrow} class="text-muted" />
        <h1 class="page-title mt-7 text-highlighted">{title}</h1>
        <p class="section-intro mt-7 max-w-lg text-muted">{description}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <AppButton href={primaryAction.href} size="lg">
            {primaryAction.label}<IconArrowRight slot="icon-right" />
          </AppButton>
          <AppButton href={secondaryAction.href} size="lg" variant="ghost">{secondaryAction.label}</AppButton>
        </div>
      </div>
      <AppBrandPanel />
    </div>
    <div class="hero-baseline">
      <p>Een klein team voor grote ideeën.</p>
      <p class="flex gap-5"><span>Strategie</span><span>Design</span><span>Techniek</span></p>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(3.5rem, 6vw, 6rem); }
  .hero-grid { display: grid; align-items: center; gap: 3rem; }
  .hero-copy h1 { max-width: 11ch; }
  .hero-baseline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: clamp(3rem, 6vw, 5rem); padding-block: 1.5rem; border-top: 1px solid var(--ui-border); font-size: 0.6875rem; letter-spacing: 0.025em; color: var(--ui-text-muted); }
  @media (min-width: 64rem) { .hero-grid { grid-template-columns: 1.2fr 0.8fr; gap: 5rem; } }
</style>
