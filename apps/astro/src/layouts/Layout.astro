---
import AppFooter from '@/components/app/footer/AppFooter.astro'
import AppHeader from '@/components/app/header/AppHeader.astro'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Vibefusion — digitale ervaringen met karakter',
  description = 'Websites met karakter, gemaakt vanuit heldere strategie, sterk design en slimme techniek.',
} = Astro.props
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ga naar inhoud</a>
    <AppHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <AppFooter />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--ui-bg-inverted);
    color: var(--ui-text-inverted);
    border-radius: var(--radius-md);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: translateY(0); }
</style>
