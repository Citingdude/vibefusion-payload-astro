---
import { Font } from 'astro:assets'
import AppFooter from '@/components/app/footer/AppFooter.astro'
import AppHeader from '@/components/app/header/AppHeader.astro'
import '@/styles/global.css'

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <title>{title}</title>
  </head>
  <body>
    <AppHeader />
    <main>
      <slot />
    </main>
    <AppFooter />
  </body>
</html>
